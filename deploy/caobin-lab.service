[Unit]
Description=Caobin Lab website
After=network.target

[Service]
User=caobinlab
Group=caobinlab
WorkingDirectory=/srv/caobin-lab/current
EnvironmentFile=/etc/caobin-lab/environment
ExecStart=/srv/caobin-lab/venv/bin/waitress-serve --listen=127.0.0.1:8771 --trusted-proxy=127.0.0.1 --trusted-proxy-count=1 --trusted-proxy-headers="x-forwarded-proto x-forwarded-for" --max-request-body-size=60000000 config.wsgi:application
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/caobin-lab/data

[Install]
WantedBy=multi-user.target
